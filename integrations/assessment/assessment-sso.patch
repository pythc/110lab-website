+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFile} from 'node:fs/promises';
+import {Pool} from 'pg';
+import {createPool,migrate} from './db.js';
+
+test('rolling migration aborts on a busy legacy table, then retries without changing old sessions',
+ {skip:!process.env.TEST_DATABASE_URL&&'needs a disposable PostgreSQL database'},async()=>{
+  const url=process.env.TEST_DATABASE_URL!,schema='assessment_rolling_'+process.pid;
+  const pool=createPool(url,schema);let blocker;
+  try{
+   await pool.query(`CREATE SCHEMA ${schema}`);
+   for(const id of ['001_init','002_oauth','003_direct_upload','004_admin_deletion','005_exam_duration','006_registration_protection']){
+    await pool.query(await readFile(new URL('../migrations/'+id+'.sql',import.meta.url),'utf8'));
+    await pool.query('INSERT INTO schema_migrations(id) VALUES($1)',[id]);
+   }
+   const user=(await pool.query("INSERT INTO users(role,name,email,password_hash) VALUES('CANDIDATE','虚构考生','fixture@example.test','fixture') RETURNING id")).rows[0];
+   await pool.query("INSERT INTO sessions(user_id,csrf_token,expires_at) VALUES($1,'fixture',now()+interval '1 hour')",[user.id]);
+   const before=await pool.query('SELECT row_to_json(s) AS value FROM sessions s');
+   blocker=await pool.connect();await blocker.query('BEGIN');await blocker.query('LOCK TABLE users IN ROW EXCLUSIVE MODE');
+   const started=Date.now();
+   await assert.rejects(()=>migrate(pool,schema),(error:unknown)=>(error as {code?:string}).code==='55P03');
+   assert.ok(Date.now()-started<6000,'busy migration fails before candidate request timeout');
+   assert.equal((await pool.query("SELECT to_regclass($1) AS name",[schema+'.lab_sso_flows'])).rows[0].name,null,'failed migration is atomic');
+   assert.equal((await pool.query("SELECT 1 FROM schema_migrations WHERE id='007_lab_sso'")).rowCount,0);
+   assert.deepEqual((await pool.query('SELECT row_to_json(s) AS value FROM sessions s')).rows,before.rows);
+   await blocker.query('COMMIT');blocker.release();blocker=undefined;
+   await migrate(pool,schema);
+   assert.equal((await pool.query("SELECT 1 FROM schema_migrations WHERE id='007_lab_sso'")).rowCount,1);
+   assert.deepEqual((await pool.query('SELECT row_to_json(s) AS value FROM sessions s')).rows,before.rows);
+  }finally{
+   if(blocker){await blocker.query('ROLLBACK');blocker.release();}
+   await pool.end();const cleanup=new Pool({connectionString:url});
+   try{await cleanup.query(`DROP SCHEMA IF EXISTS ${schema} CASCADE`);}finally{await cleanup.end();}
+  }
+ });
