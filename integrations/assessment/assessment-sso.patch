+import {createHash,randomBytes,randomUUID,createCipheriv,createDecipheriv} from 'node:crypto';
+import {existsSync} from 'node:fs';
+import type {Express,Response as ExpressResponse} from 'express';
+import {z} from 'zod';
+import type {AppContext} from './context.js';
+import {HttpError} from './errors.js';
+import {asyncHandler,readCookie} from './http.js';
+import {setSessionCookie} from './auth.js';
+import {withTx} from './db.js';
+import {insertAudit} from './audit.js';
+import {assertRateLimit} from './rateLimit.js';
+
+const ISSUER='https://internal.110-lab.cn';
+const CALLBACK='https://exam.110-lab.cn/api/auth/feishu/callback';
+const nonce=()=>randomBytes(32).toString('base64url');
+const hash=(value:string)=>createHash('sha256').update(value).digest('hex');
+const opaque=z.string().regex(/^[\w-]{43}$/);
+const identitySchema=z.object({
+  issuer:z.literal(ISSUER),audience:z.literal('assessment'),
+  subject:z.string().regex(/^[A-Za-z0-9_-]{4,80}:on_[A-Za-z0-9_-]{10,100}$/),name:z.string().min(1).max(80),
+  email:z.string().email().max(254).regex(/@110-lab\.cn$/i),
+  role:z.enum(['admin','super_admin']),expiresAt:z.string().datetime(),
+  token:opaque.optional(),
+});
+type Identity=z.infer<typeof identitySchema>;
+export function labSsoAvailable(ctx:AppContext):boolean{
+  return !!ctx.config.labSsoEnabled && !(ctx.config.labSsoFreezeFile && existsSync(ctx.config.labSsoFreezeFile));
+}
+
+export function sealSsoGrant(ctx:AppContext,token:string,sessionId:string):string{
+  const iv=randomBytes(12),key=createHash('sha256').update('lab-sso:'+ctx.config.sessionSecret).digest();
+  const cipher=createCipheriv('aes-256-gcm',key,iv);cipher.setAAD(Buffer.from(sessionId));
+  return [iv.toString('base64url'),Buffer.concat([cipher.update(token,'utf8'),cipher.final()]).toString('base64url'),cipher.getAuthTag().toString('base64url')].join('.');
+}
+export function unsealSsoGrant(ctx:AppContext,value:string,sessionId:string):string{
+  const [iv,body,tag]=value.split('.');if(!iv||!body||!tag)throw new Error('Invalid sealed grant');
+  const key=createHash('sha256').update('lab-sso:'+ctx.config.sessionSecret).digest();
+  const decipher=createDecipheriv('aes-256-gcm',key,Buffer.from(iv,'base64url'));decipher.setAAD(Buffer.from(sessionId));decipher.setAuthTag(Buffer.from(tag,'base64url'));
+  return Buffer.concat([decipher.update(Buffer.from(body,'base64url')),decipher.final()]).toString('utf8');
+}
+async function exchange(ctx:AppContext,endpoint:'exchange'|'inspect',payload:Record<string,string>):Promise<Identity>{
+  const request=ctx.config.nodeEnv==='test'&&ctx.labSsoFetch?ctx.labSsoFetch:fetch;
+  let response:globalThis.Response;
+  try{response=await request(ISSUER+'/api/mail/sso/'+endpoint,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload),redirect:'error',signal:AbortSignal.timeout(5000)});}
+  catch{throw new HttpError(503,'暂时无法确认实验室身份 请稍后重试','LAB_SSO_UNAVAILABLE');}
+  const r=response;
+  if(!r.ok)throw new HttpError(r.status===403?403:r.status===401?401:503,'实验室登录已失效或没有管理员权限','LAB_SSO_DENIED');
+  const text=await r.text();if(text.length>8192)throw new HttpError(502,'实验室身份响应无效','LAB_SSO_INVALID');
+  let value:unknown;try{value=JSON.parse(text);}catch{throw new HttpError(502,'实验室身份响应无效','LAB_SSO_INVALID');}
+  const parsed=identitySchema.safeParse(value);
+  if(!parsed.success||Date.parse(parsed.data.expiresAt)<=Date.now()||Date.parse(parsed.data.expiresAt)>Date.now()+8*3600000+5000)throw new HttpError(401,'实验室身份已失效','LAB_SSO_INVALID');
+  if(endpoint==='exchange'&&!parsed.data.token)throw new HttpError(502,'实验室登录凭证缺失','LAB_SSO_INVALID');
+  return parsed.data;
+}
+export async function verifyLabSession(ctx:AppContext,sessionId:string,subject:string,sealed:string):Promise<Identity>{
+  if(!labSsoAvailable(ctx))throw new HttpError(401,'实验室登录已停用','LAB_SSO_DISABLED');
+  let token:string;try{token=unsealSsoGrant(ctx,sealed,sessionId);}catch{throw new HttpError(401,'实验室登录已失效','LAB_SSO_INVALID');}
+  const profile=await exchange(ctx,'inspect',{token});
+  if(!labSsoAvailable(ctx))throw new HttpError(401,'实验室登录已停用','LAB_SSO_DISABLED');
+  if(profile.subject!==subject)throw new HttpError(401,'实验室身份不一致','LAB_SSO_INVALID');
+  return profile;
+}
+function flowCookie(ctx:AppContext,res:ExpressResponse,value:string,embedded:boolean,maxAge=300){
+  res.append('Set-Cookie',`${embedded?'__Host-lab_sso_flow_embedded':'__Host-lab_sso_flow'}=${value}; Path=/; HttpOnly; SameSite=${embedded?'None':'Lax'}; Max-Age=${maxAge}${ctx.config.cookieSecure?'; Secure':''}${embedded?'; Partitioned':''}`);
+}
+export function registerLabSso(app:Express,ctx:AppContext):void{
