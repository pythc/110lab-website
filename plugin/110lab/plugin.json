{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "110lab",
  "version": "0.6.1",
  "description": "110 实验室工作台：批改系统、考核系统与需求平台的快捷入口。",
  "author": {
    "name": "110 实验室"
  },
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "110lab",
        "shortDescription": "110 实验室的应用工作台",
        "longDescription": "从侧边栏进入 110 实验室工作台，直接打开批改系统内网版、批改系统外网版、考核系统或需求平台。外网批改系统已启用，内网应用需要校园网络或 VPN。",
        "developerName": "110 实验室",
        "category": "Productivity",
        "capabilities": [
          "Interactive"
        ],
        "logo": "./assets/logo.png",
        "composerIcon": "./assets/sidebar-icon.png",
        "defaultPrompt": "打开 110lab 首页，看看实验室项目。"
      }
